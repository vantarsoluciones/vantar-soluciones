---
// Botón flotante de WhatsApp — solo mobile, discreto y on-brand.
// Dispara `click_whatsapp` como todo botón de WhatsApp (listener global del layout).
import { WA_LINK } from './config';
---
<a
  href={WA_LINK}
  data-loc="flotante"
  target="_blank"
  rel="noopener noreferrer"
  class="wa-flotante"
  aria-label="Escribinos por WhatsApp"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2a10 10 0 0 0-8.66 15L2.1 21.42a.75.75 0 0 0 .92.93l4.55-1.21A10 10 0 1 0 12 2Zm0 18.13a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.06.81.82-3-.2-.31A8.13 8.13 0 1 1 12 20.13Zm4.46-6.08c-.24-.12-1.44-.71-1.66-.79s-.39-.12-.55.12-.63.79-.77.95-.28.18-.53.06a6.66 6.66 0 0 1-1.96-1.21 7.33 7.33 0 0 1-1.35-1.68c-.14-.24 0-.37.11-.5s.24-.28.37-.42a1.68 1.68 0 0 0 .24-.41.45.45 0 0 0 0-.43c-.06-.12-.55-1.32-.75-1.81s-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.73 2.73 0 0 0-.85 2 4.74 4.74 0 0 0 1 2.52 10.88 10.88 0 0 0 4.16 3.68 14.1 14.1 0 0 0 1.39.51 3.35 3.35 0 0 0 1.53.1 2.5 2.5 0 0 0 1.64-1.16 2 2 0 0 0 .14-1.16c-.06-.1-.22-.16-.46-.28Z"/>
  </svg>
</a>

<style>
  .wa-flotante {
    display: none;
    position: fixed;
    right: 18px;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    z-index: 45;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--navy-elevated);
    border: 1px solid var(--line-strong);
    color: var(--bronze-light);
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
    transition: background 0.25s ease, color 0.25s ease;
  }
  .wa-flotante:active,
  .wa-flotante:hover {
    background: var(--bronze);
    color: var(--bg);
  }

  @media (max-width: 900px) {
    .wa-flotante {
      display: flex;
    }
  }
</style>
