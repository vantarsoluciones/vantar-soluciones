---
import { WA_LINK, SCHEDULER_URL } from './config';
---
<section id="agendar" class="section">
  <div class="container agendar-container">
    <div class="label-sec reveal">Agendá</div>

    <h2 class="h-display sec-title-lg reveal d1">
      Atendé más casos, <em>los que valen la pena.</em>
    </h2>
    <p class="lead intro reveal d2">
      Una reunión de 15 minutos, sin compromiso: te mostramos el circuito completo
      andando y vemos si tiene sentido para tu estudio. Sin precio oculto ni
      letra chica, todo se conversa de frente.
    </p>

    <div class="agendar-panel reveal d2" id="agendar-panel" data-scheduler-url={SCHEDULER_URL}>
      {SCHEDULER_URL ? (
        <div>
          <div class="embed-wrap" id="agendar-embed-wrap">
            <span class="embed-cargando">Cargando la agenda…</span>
          </div>
          <div class="alternativa">
            <span class="alternativa-texto">¿Preferís coordinarlo por WhatsApp?</span>
            <a href={WA_LINK} data-loc="agendar" target="_blank" rel="noopener noreferrer" class="btn-outline">
              Escribinos por WhatsApp
            </a>
          </div>
        </div>
      ) : (
        <div class="fallback">
          <p class="lead fallback-texto">
            Elegimos juntos el día y el horario por WhatsApp: escribinos y en el
            mismo chat queda coordinada la reunión.
          </p>
          <a href={WA_LINK} data-loc="agendar" target="_blank" rel="noopener noreferrer" class="btn-bronze">
            Agendá una reunión de 15 minutos
          </a>
          <a href="mailto:vantarsoluciones@gmail.com?subject=Reuni%C3%B3n%20de%2015%20minutos" class="nav-anchor fallback-mail">
            O escribinos a vantarsoluciones@gmail.com
          </a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .agendar-container {
    max-width: 860px;
  }
  .intro {
    font-size: 0.98rem;
    line-height: 1.8;
    max-width: 560px;
    margin-top: 22px;
  }

  .embed-wrap {
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border-radius: 2px;
  }
  .embed-cargando {
    font-family: var(--font-body);
    font-size: 13px;
    color: #54656F;
  }
  .alternativa {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .alternativa-texto {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--cream-60);
  }

  .fallback {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }
  .fallback-texto {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--cream-70);
    max-width: 520px;
  }
  .fallback-mail {
    font-size: 13px;
  }
</style>

<script>
  // Embed diferido del agendador: se carga recién cuando la sección se acerca
  // al viewport, con los UTMs de la visita adosados a la URL.
  const panel = document.getElementById('agendar-panel');
  const url = panel?.getAttribute('data-scheduler-url');

  if (panel && url) {
    const load = () => {
      const wrap = document.getElementById('agendar-embed-wrap');
      if (!wrap || wrap.querySelector('iframe')) return;
      let finalUrl = url;
      try {
        const saved = sessionStorage.getItem('vantar_utms');
        if (saved) {
          const u = new URL(url);
          JSON.parse(saved).forEach(([k, v]) => u.searchParams.set(k, v));
          finalUrl = u.toString();
        }
      } catch (e) {}
      const iframe = document.createElement('iframe');
      iframe.className = 'agendar-embed';
      iframe.src = finalUrl;
      iframe.title = 'Agendar una reunión de 15 minutos';
      iframe.loading = 'lazy';
      iframe.style.minHeight = '620px';
      wrap.innerHTML = '';
      wrap.appendChild(iframe);
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          load();
          io.disconnect();
        }
      },
      { rootMargin: '600px 0px' }
    );
    io.observe(panel);

    // Conversión primaria: aviso de reserva completada del widget (Cal.com y
    // similares emiten postMessage con "bookingSuccessful").
    window.addEventListener('message', (e) => {
      try {
        const raw = typeof e.data === 'string' ? e.data : JSON.stringify(e.data);
        if (raw && raw.indexOf('bookingSuccessful') !== -1) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'reunion_agendada' });
        }
      } catch (err) {}
    });
  }
</script>
