---
// Armador de las rutas de campaña /abogados/*. La landing completa se renderiza
// sin `first`; cada subruta (vínculo de sitio de Google Ads) pasa `first` y un
// encabezado propio, y muestra su sección homónima primero y el resto debajo.
// La demo activa es la INTERACTIVA (AsistenteDemo); la variante video vive en
// AsistenteDemoVideo.astro — cambiar el import para alternar.
import LayoutV2 from '../../layouts/LayoutV2.astro';
import NavV2 from './NavV2.astro';
import HeroV2 from './HeroV2.astro';
import ComoFunciona from './ComoFunciona.astro';
import AsistenteDemo from './AsistenteDemo.astro';
import CasoMedido from './CasoMedido.astro';
import Equipo from './Equipo.astro';
import ParaQuien from './ParaQuien.astro';
import FaqV2 from './FaqV2.astro';
import Agendar from './Agendar.astro';
import FlotanteWA from './FlotanteWA.astro';
import FooterV2 from './FooterV2.astro';

interface Props {
  first?: 'como-funciona' | 'asistente' | 'equipo' | 'agendar' | 'preguntas';
  title: string;
  description: string;
  h1?: string;
  intro?: string;
}
const { first, title, description, h1, intro } = Astro.props;

const SECCIONES: Array<[string, any]> = [
  ['como-funciona', ComoFunciona],
  ['asistente', AsistenteDemo],
  ['medido', CasoMedido],
  ['equipo', Equipo],
  ['para-quien', ParaQuien],
  ['preguntas', FaqV2],
  ['agendar', Agendar],
];

const orden = first
  ? [...SECCIONES.filter(([k]) => k === first), ...SECCIONES.filter(([k]) => k !== first)]
  : SECCIONES;
---
<LayoutV2 title={title} description={description}>
  <NavV2 />
  <main>
    {!first && <HeroV2 />}
    {first && h1 && (
      <header class="sub-intro">
        <div class="container">
          <p class="sub-intro-marca">VantAr · Marketing para abogados</p>
          <h1 class="h-display sub-intro-titulo" set:html={h1} />
          {intro && <p class="sub-intro-bajada">{intro}</p>}
          <a href="#agendar" class="btn-bronze">Agendá una reunión de 15 minutos</a>
        </div>
      </header>
    )}
    {orden.map((entry) => {
      const Seccion = entry[1];
      return <Seccion />;
    })}
  </main>
  <FlotanteWA />
  <FooterV2 />
</LayoutV2>

<style>
  .sub-intro {
    padding: 150px 32px 70px;
    background: var(--bg);
  }
  .sub-intro-marca {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bronze);
    margin: 0 0 22px;
  }
  .sub-intro-titulo {
    font-size: clamp(2rem, 4.6vw, 3.2rem);
    max-width: 820px;
  }
  .sub-intro-bajada {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    font-weight: 300;
    color: var(--cream-60);
    line-height: 1.8;
    max-width: 560px;
    margin: 22px 0 30px;
  }

  @media (max-width: 900px) {
    .sub-intro {
      padding: 120px 22px 56px;
    }
    .sub-intro :global(.btn-bronze) {
      width: 100%;
    }
  }
</style>
