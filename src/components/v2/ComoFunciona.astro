---
// El circuito completo contado como línea temporal de un fin de semana:
// la línea se llena de bronce a medida que se recorre.
const PASOS = [
  {
    folio: 'a.',
    dia: 'sábado',
    hora: '23:47',
    titulo: 'La publicidad capta la consulta',
    texto:
      'Alguien acaba de tener un problema y busca abogado en Google. Ve tu anuncio, entra y escribe por WhatsApp. Campañas de Google Ads para abogados pensadas para una sola cosa: conseguir clientes que ya te están buscando.',
  },
  {
    folio: 'b.',
    dia: 'sábado',
    hora: '23:48',
    titulo: 'El asistente atiende, entrevista y califica',
    texto:
      'Un minuto después, la respuesta ya salió. El asistente entrevista con las preguntas de tu estudio, entiende audios y fotos, y califica el caso según tus criterios. A cualquier hora, cualquier día.',
  },
  {
    folio: 'c.',
    dia: 'sábado',
    hora: '23:58',
    titulo: 'La reunión queda en tu calendario',
    texto:
      'El cliente elige horario y el asistente agenda la cita directamente en tu calendario. Antes de la reunión, se la recuerda para que llegue.',
  },
  {
    folio: 'd.',
    dia: 'lunes',
    hora: '08:30',
    titulo: 'Te llega el caso, resumido y priorizado',
    texto:
      'Abrís el lunes con la entrevista hecha: qué pasó, qué documentación mandó, qué urgencia tiene y la reunión ya puesta. Vos decidís si lo tomás.',
  },
];
---
<section id="como-funciona" class="section section-alt">
  <div class="container">
    <div class="label-sec reveal">Cómo funciona</div>

    <h2 class="h-display sec-title-lg reveal d1 titulo">
      Un fin de semana <em>cualquiera.</em>
    </h2>
    <p class="lead intro reveal d2">
      Esto pasa mientras tu estudio está cerrado. Cuatro pasos, cero intervención
      de tu equipo.
    </p>

    <div class="tl-wrap" id="tl-wrap">
      <div class="tl-rail" aria-hidden="true">
        <div class="tl-fill" id="tl-fill"></div>
      </div>

      {PASOS.map((p) => (
        <div class="tl-step">
          <div class="tl-node" aria-hidden="true"></div>
          <div class="tl-time reveal">
            {p.hora}
            <small>{p.dia}</small>
          </div>
          <div class="tl-body reveal d1">
            <h3><span class="folio" aria-hidden="true">{p.folio}</span>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="cierre reveal">
      Cada parte alimenta a la siguiente: es tu área comercial tercerizada,
      funcionando de punta a punta.
    </p>
  </div>
</section>

<style>
  .titulo {
    max-width: 640px;
  }
  .intro {
    font-size: 0.98rem;
    line-height: 1.8;
    max-width: 540px;
    margin-top: 22px;
  }
  .cierre {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--cream-70);
    line-height: 1.8;
    max-width: 560px;
    margin: 64px 0 0;
    border-left: 1px solid var(--line-strong);
    padding-left: 18px;
  }
</style>

<script>
  // La línea de tiempo se va "llenando" de bronce a medida que se recorre
  const wrap = document.getElementById('tl-wrap');
  const fill = document.getElementById('tl-fill');
  let raf = 0;

  function update() {
    raf = 0;
    if (!wrap || !fill) return;
    const r = wrap.getBoundingClientRect();
    const vh = window.innerHeight;
    const progress = Math.min(1, Math.max(0, (vh * 0.65 - r.top) / r.height));
    fill.style.height = (progress * 100).toFixed(1) + '%';
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!raf) raf = requestAnimationFrame(update);
    },
    { passive: true }
  );
  update();
</script>
