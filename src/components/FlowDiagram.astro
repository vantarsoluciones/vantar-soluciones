<script>
(function() {
  const CHAT = [
    { from: 'client', type: 'text', text: 'Hola, sufrí un accidente laboral y necesito asesoramiento' },
    { from: 'agent',  type: 'text', text: '¡Hola! Con gusto te ayudamos. ¿Cuándo ocurrió el accidente?' },
    { from: 'client', type: 'text', text: 'Fue el lunes a la mañana' },
    { from: 'agent',  type: 'text', text: '¿Podés contarnos brevemente cómo fue?' },
    { from: 'client', type: 'audio' },
    { from: 'agent',  type: 'text', text: 'Entendido. ¿Podés enviarnos el informe médico de la guardia?' },
    { from: 'client', type: 'image' },
    { from: 'agent',  type: 'text', text: 'Recibí el informe. Veo que el diagnóstico es esguince grado II de muñeca derecha, atendido el lunes a las 10:23 hs por el Dr. Ramírez. Anotado. ¿Tu empresa tiene ART?' },
    { from: 'client', type: 'text', text: 'Sí, creo que es Galeno' },
    { from: 'agent',  type: 'text', text: '¿Tu empleador estaba al tanto cuando ocurrió?' },
    { from: 'client', type: 'text', text: 'Sí, le avisé a mi jefe ese mismo día' },
    { from: 'agent',  type: 'text', text: 'Perfecto. ¿Tenés disponibilidad esta semana para una consulta?' },
    { from: 'client', type: 'text', text: 'El jueves a la mañana me viene bien' },
    { from: 'agent',  type: 'text', text: 'Te confirmo turno para el jueves a las 10:00 hs. Te va a atender la Dra. Peralta. ¡Hasta el jueves!' },
  ];

  let visibleCount = 0;
  let timer = null;
  let charInterval = null;

  const msgs      = document.getElementById('chat-messages');
  const typing    = document.getElementById('typing-indicator');
  const inputDisp = document.getElementById('input-display');
  const cursor    = document.getElementById('cursor-blink');
  const sendIcon  = document.getElementById('send-icon');
  const camIcon   = document.getElementById('camera-icon');
  const waStatus  = document.getElementById('wa-status');

  function scrollBottom() {
    if (msgs) msgs.scrollTop = msgs.scrollHeight;
  }

  function showMsg(i) {
    const el = document.querySelector(`[data-msg="${i}"]`);
    if (el) { el.style.display = 'flex'; scrollBottom(); }
  }

  function showTyping(show) {
    if (!typing) return;
    typing.style.display = show ? 'flex' : 'none';
    if (waStatus) waStatus.style.color = show ? '#A8E6D0' : 'rgba(255,255,255,0.7)';
    if (waStatus) waStatus.textContent = show ? 'escribiendo...' : 'en línea';
    if (show) scrollBottom();
  }

  function setInput(text) {
    if (!inputDisp) return;
    if (text) {
      inputDisp.textContent = text;
      inputDisp.style.color = '#111';
      if (sendIcon) { sendIcon.style.display = 'flex'; }
      if (camIcon)  { camIcon.style.display = 'none'; }
    } else {
      inputDisp.textContent = 'Mensaje';
      inputDisp.style.color = '#9EA5AE';
      if (sendIcon) { sendIcon.style.display = 'none'; }
      if (camIcon)  { camIcon.style.display = 'block'; }
    }
  }

  function setActiveKey(key) {
    document.querySelectorAll('.kb-key').forEach(k => k.classList.remove('active'));
    if (key) {
      const el = document.querySelector(`[data-key="${key.toUpperCase()}"]`);
      if (el) el.classList.add('active');
    }
  }

  function showCursor(show) {
    if (!cursor) return;
    cursor.style.display = show ? 'inline-block' : 'none';
  }

  function reset() {
    visibleCount = 0;
    document.querySelectorAll('[data-msg]').forEach(el => { (el as HTMLElement).style.display = 'none'; });
    setInput('');
    setActiveKey('');
    showCursor(false);
    showTyping(false);
    orchestrate();
  }

  function orchestrate() {
    if (visibleCount >= CHAT.length) {
      timer = setTimeout(reset, 3500);
      return;
    }
    const next = CHAT[visibleCount];
    if (next.from === 'agent') {
      showTyping(true);
      const delay = Math.min((next.text?.length ?? 20) * 26 + 900, 3200);
      timer = setTimeout(() => { showTyping(false); showMsg(visibleCount); visibleCount++; orchestrate(); }, delay);
    } else if (next.type === 'audio') {
      timer = setTimeout(() => { showMsg(visibleCount); visibleCount++; orchestrate(); }, 3200);
    } else if (next.type === 'image') {
      timer = setTimeout(() => { showMsg(visibleCount); visibleCount++; orchestrate(); }, 2200);
    } else {
      timer = setTimeout(() => { startClientTyping(next.text ?? ''); }, 1100);
    }
  }

  function startClientTyping(target) {
    let i = 0;
    showCursor(true);
    const charDelay = Math.max(50, Math.min(95, 1600 / Math.max(target.length, 1)));
    charInterval = setInterval(() => {
      i++;
      const char = target[i - 1];
      setInput(target.slice(0, i));
      if (char) { setActiveKey(char); setTimeout(() => setActiveKey(''), Math.round(charDelay * 0.7)); }
      if (i >= target.length) {
        clearInterval(charInterval);
        setTimeout(() => { setInput(''); setActiveKey(''); showCursor(false); showMsg(visibleCount); visibleCount++; orchestrate(); }, 600);
      }
    }, charDelay);
  }

  orchestrate();
})();
</script>
