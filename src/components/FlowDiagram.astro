<script>
(function () {
  const CHAT = [
    { from: 'client', type: 'text',  text: 'Hola, sufrí un accidente laboral y necesito asesoramiento' },
    { from: 'agent',  type: 'text',  text: '¡Hola! Con gusto te ayudamos. ¿Cuándo ocurrió el accidente?' },
    { from: 'client', type: 'text',  text: 'Fue el lunes a la mañana' },
    { from: 'agent',  type: 'text',  text: '¿Podés contarnos brevemente cómo fue?' },
    { from: 'client', type: 'audio' },
    { from: 'agent',  type: 'text',  text: 'Entendido. ¿Podés enviarnos el informe médico de la guardia?' },
    { from: 'client', type: 'image' },
    { from: 'agent',  type: 'text',  text: 'Recibí el informe. Veo que el diagnóstico es esguince grado II de muñeca derecha, atendido el lunes a las 10:23 hs por el Dr. Ramírez. Anotado. ¿Tu empresa tiene ART?' },
    { from: 'client', type: 'text',  text: 'Sí, creo que es Galeno' },
    { from: 'agent',  type: 'text',  text: '¿Tu empleador estaba al tanto cuando ocurrió?' },
    { from: 'client', type: 'text',  text: 'Sí, le avisé a mi jefe ese mismo día' },
    { from: 'agent',  type: 'text',  text: 'Perfecto. ¿Tenés disponibilidad esta semana para una consulta?' },
    { from: 'client', type: 'text',  text: 'El jueves a la mañana me viene bien' },
    { from: 'agent',  type: 'text',  text: 'Te confirmo turno para el jueves a las 10:00 hs. Te va a atender la Dra. Peralta. ¡Hasta el jueves!' },
  ] as const;

  type ChatEntry = typeof CHAT[number];

  let i = 0;
  let running = false;
  let runId = 0;

  const msgs     = document.getElementById('chat-messages') as HTMLElement | null;
  const typing   = document.getElementById('typing-indicator') as HTMLElement | null;
  const inputEl  = document.getElementById('input-display') as HTMLElement | null;
  const cursor   = document.getElementById('cursor-blink') as HTMLElement | null;
  const sendIcon = document.getElementById('send-icon') as HTMLElement | null;
  const camIcon  = document.getElementById('camera-icon') as HTMLElement | null;
  const waStatus = document.getElementById('wa-status') as HTMLElement | null;
  const phone    = document.getElementById('phone-wrap') as HTMLElement | null;

  const wait = (ms: number) => new Promise<void>((res) => setTimeout(res, ms));
  const jitter = (ms: number, spread = 0.35) => ms * (1 - spread + Math.random() * spread * 2);

  function scrollBottom() {
    if (msgs) msgs.scrollTo({ top: msgs.scrollHeight, behavior: 'smooth' });
  }

  function setStatus(text: string) {
    if (!waStatus) return;
    waStatus.textContent = text;
    waStatus.style.color = text === 'en línea' ? 'rgba(255,255,255,0.7)' : '#A8E6D0';
  }

  function showMsg(idx: number) {
    const el = document.querySelector(`[data-msg="${idx}"]`) as HTMLElement | null;
    if (el) {
      el.style.display = 'flex';
      el.style.animation = 'msg-in 0.3s ease-out both';
      scrollBottom();
    }
    return el;
  }

  async function progressTicks(el: HTMLElement | null, id: number) {
    const ticks = el && (el.querySelector('[data-ticks]') as HTMLElement | null);
    if (!ticks) return;
    ticks.dataset.state = 'sent';
    await wait(jitter(500)); if (id !== runId) return;
    ticks.dataset.state = 'delivered';
    await wait(jitter(700)); if (id !== runId) return;
    ticks.dataset.state = 'read';
  }

  function setInput(text: string) {
    if (!inputEl) return;
    if (text) {
      inputEl.textContent = text;
      inputEl.style.color = '#111';
      if (sendIcon) sendIcon.style.display = 'flex';
      if (camIcon) camIcon.style.display = 'none';
    } else {
      inputEl.textContent = 'Mensaje';
      inputEl.style.color = '#9EA5AE';
      if (sendIcon) sendIcon.style.display = 'none';
      if (camIcon) camIcon.style.display = 'block';
    }
  }

  function setActiveKey(key: string) {
    document.querySelectorAll('.kb-key').forEach((k) => k.classList.remove('active'));
    if (key) {
      const el = document.querySelector(`[data-key="${key.toUpperCase()}"]`);
      if (el) el.classList.add('active');
    }
  }

  async function clientTypes(text: string, id: number) {
    if (cursor) cursor.style.display = 'inline-block';
    await wait(jitter(900)); if (id !== runId) return;
    for (let c = 1; c <= text.length; c++) {
      setInput(text.slice(0, c));
      setActiveKey(text[c - 1]);
      await wait(45 + Math.random() * 65 + (Math.random() < 0.06 ? 220 : 0));
      setActiveKey('');
      if (id !== runId) return;
    }
    await wait(jitter(450)); if (id !== runId) return;
    setInput('');
    if (cursor) cursor.style.display = 'none';
  }

  async function playAudio(el: HTMLElement | null, id: number) {
    const bars = el ? Array.from(el.querySelectorAll('[data-wavebar]')) as HTMLElement[] : [];
    const counter = el && (el.querySelector('[data-audio-time]') as HTMLElement | null);
    for (let b = 0; b < bars.length; b++) {
      bars[b].style.background = '#128C7E';
      if (counter) {
        const secs = Math.floor(((b + 1) / bars.length) * 14);
        counter.textContent = '0:' + String(secs).padStart(2, '0');
      }
      await wait(34);
      if (id !== runId) return;
    }
  }

  function resetChat() {
    document.querySelectorAll('[data-msg]').forEach((el) => {
      (el as HTMLElement).style.display = 'none';
      (el as HTMLElement).style.animation = '';
    });
    const overlay = document.querySelector('[data-upload-overlay]') as HTMLElement | null;
    if (overlay) { overlay.style.transition = ''; overlay.style.opacity = '1'; }
    document.querySelectorAll('[data-wavebar]').forEach((b) => { (b as HTMLElement).style.background = '#A0A8A0'; });
    const at = document.querySelector('[data-audio-time]') as HTMLElement | null;
    if (at) at.textContent = '0:14';
    const tr = document.querySelector('[data-transcript]') as HTMLElement | null;
    if (tr) tr.style.display = 'none';
    document.querySelectorAll('[data-ticks]').forEach((t) => { (t as HTMLElement).dataset.state = 'none'; });
    if (typing) typing.style.display = 'none';
    setInput('');
    setActiveKey('');
    if (cursor) cursor.style.display = 'none';
    setStatus('en línea');
    if (msgs) msgs.scrollTop = 0;
  }

  async function step(id: number) {
    while (id === runId) {
      if (i >= CHAT.length) {
        await wait(4000); if (id !== runId) return;
        if (msgs) {
          msgs.style.animation = 'chat-fade 0.6s ease both';
          await wait(650); if (id !== runId) { msgs.style.animation = ''; return; }
          resetChat();
          msgs.style.animation = '';
        }
        i = 0;
        continue;
      }

      const m = CHAT[i] as ChatEntry;

      if (m.from === 'agent') {
        await wait(jitter(800)); if (id !== runId) return;
        setStatus('escribiendo…');
        if (typing) { typing.style.display = 'flex'; scrollBottom(); }
        const textLen = m.type === 'text' ? m.text.length : 20;
        await wait(Math.min(textLen * 28 + 700, 3400)); if (id !== runId) return;
        if (typing) typing.style.display = 'none';
        setStatus('en línea');
        showMsg(i);
      } else if (m.type === 'audio') {
        setStatus('grabando audio…');
        await wait(jitter(2600)); if (id !== runId) return;
        setStatus('en línea');
        const el = showMsg(i);
        progressTicks(el, id);
        await wait(600); if (id !== runId) return;
        await playAudio(el, id); if (id !== runId) return;
        const tr = el && (el.querySelector('[data-transcript]') as HTMLElement | null);
        if (tr) { tr.style.display = 'block'; scrollBottom(); }
      } else if (m.type === 'image') {
        await wait(jitter(1600)); if (id !== runId) return;
        const el = showMsg(i);
        progressTicks(el, id);
        const overlay = el && (el.querySelector('[data-upload-overlay]') as HTMLElement | null);
        const pct = el && (el.querySelector('[data-upload-pct]') as HTMLElement | null);
        if (overlay && pct) {
          let p = 0;
          while (p < 100) {
            p = Math.min(p + 4 + Math.floor(Math.random() * 9), 100);
            pct.textContent = p + '%';
            await wait(70); if (id !== runId) return;
          }
          overlay.style.transition = 'opacity 0.4s ease';
          overlay.style.opacity = '0';
        }
      } else {
        await clientTypes(m.text, id); if (id !== runId) return;
        const el = showMsg(i);
        progressTicks(el, id);
      }

      i++;
      await wait(jitter(500)); if (id !== runId) return;
    }
  }

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting && !running) {
        running = true;
        i = 0;
        resetChat();
        runId++;
        step(runId);
      } else if (!e.isIntersecting && running) {
        running = false;
        runId++;
      }
    }
  }, { threshold: 0.35 });
  if (phone) io.observe(phone);
})();
</script>
