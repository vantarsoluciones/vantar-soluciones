---
const FEATURES_DEMO = [
  'Entrevista con criterio, como una secretaria con experiencia',
  'Transcribe audios y lee documentos e imágenes',
  'Agenda el turno directo en tu Google Calendar',
];

const WAVEFORM = [4,8,12,18,24,26,20,30,26,20,16,24,28,22,18,14,26,22,18,12,20,16,12,8,6,10,14,8,5,3];
---

<section id="la-solucion" class="section" style="position:relative;">
  <div class="container">
    <div class="label-sec reveal">La solución, en vivo</div>

    <div class="grid-demo" style="margin-top:48px;">

      <!-- Columna copy -->
      <div>
        <h2 class="h-display reveal d1" style="font-size:clamp(1.9rem,3.4vw,2.8rem);">
          No te lo contamos.<br /><em>Miralo atender.</em>
        </h2>
        <p class="reveal d2" style="font-family:var(--font-body);font-size:0.98rem;font-weight:300;color:var(--cream-60);line-height:1.85;margin:24px 0 0;max-width:400px;">
          Esto es una conversación del asistente, igual a las que va a tener con
          tus clientes: entiende el caso, pide lo que falta y cierra el turno,
          sin que vos toques el teléfono.
        </p>
        <div style="margin-top:34px;display:flex;flex-direction:column;gap:16px;">
          {FEATURES_DEMO.map((f, i) => (
            <div class={`reveal d${i + 2}`} style="display:flex;gap:16px;align-items:center;">
              <div class="reveal-line" style="width:26px;height:1px;background:var(--bronze);flex-shrink:0;"></div>
              <span style="font-family:var(--font-body);font-size:0.9rem;color:var(--cream-60);">{f}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna teléfono -->
      <div style="display:flex;justify-content:center;align-items:flex-start;" class="reveal d2" id="phone-wrap">

        <!-- iPhone 17 Frame -->
        <div style="position:relative;width:328px;margin:0 auto;">
          <!-- Side buttons -->
          <div style="position:absolute;width:4px;height:32px;top:108px;left:-4px;background:linear-gradient(180deg,rgba(130,130,130,0.85) 0%,rgba(70,70,70,0.75) 100%);border-radius:3px 0 0 3px;border:0.5px solid rgba(255,255,255,0.2);border-right:none;box-shadow:inset 0 1px 0 rgba(255,255,255,0.28),inset 0 -1px 0 rgba(0,0,0,0.2),-2px 0 8px rgba(0,0,0,0.5);"></div>
          <div style="position:absolute;width:4px;height:62px;top:158px;left:-4px;background:linear-gradient(180deg,rgba(130,130,130,0.85) 0%,rgba(70,70,70,0.75) 100%);border-radius:3px 0 0 3px;border:0.5px solid rgba(255,255,255,0.2);border-right:none;box-shadow:inset 0 1px 0 rgba(255,255,255,0.28),inset 0 -1px 0 rgba(0,0,0,0.2),-2px 0 8px rgba(0,0,0,0.5);"></div>
          <div style="position:absolute;width:4px;height:62px;top:232px;left:-4px;background:linear-gradient(180deg,rgba(130,130,130,0.85) 0%,rgba(70,70,70,0.75) 100%);border-radius:3px 0 0 3px;border:0.5px solid rgba(255,255,255,0.2);border-right:none;box-shadow:inset 0 1px 0 rgba(255,255,255,0.28),inset 0 -1px 0 rgba(0,0,0,0.2),-2px 0 8px rgba(0,0,0,0.5);"></div>
          <div style="position:absolute;width:4px;height:88px;top:158px;right:-4px;background:linear-gradient(180deg,rgba(130,130,130,0.85) 0%,rgba(70,70,70,0.75) 100%);border-radius:0 3px 3px 0;border:0.5px solid rgba(255,255,255,0.2);border-left:none;box-shadow:inset 0 1px 0 rgba(255,255,255,0.28),inset 0 -1px 0 rgba(0,0,0,0.2),2px 0 8px rgba(0,0,0,0.5);"></div>

          <!-- Phone body -->
          <div style="background:linear-gradient(155deg,#3C3C3C 0%,#222 25%,#141414 55%,#1E1E1E 80%,#2A2A2A 100%);border-radius:46px;padding:14px 10px 15px;box-shadow:inset 0 1.5px 0 rgba(255,255,255,0.14),inset 1px 0 0 rgba(255,255,255,0.07),inset -1px 0 0 rgba(255,255,255,0.05),0 50px 120px rgba(0,0,0,0.7),0 18px 45px rgba(0,0,0,0.45),0 5px 14px rgba(0,0,0,0.35);">

            <!-- Screen -->
            <div style="border-radius:36px;overflow:hidden;background:#000;height:630px;display:flex;flex-direction:column;">

              <!-- iOS Status bar -->
              <div style="height:52px;background:#111;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;padding:0 20px;position:relative;">
                <span style="font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-weight:600;font-size:15px;color:#FFF;letter-spacing:-0.3px;">10:41</span>
                <div style="position:absolute;left:50%;transform:translateX(-50%);top:9px;width:100px;height:32px;background:#000;border-radius:18px;box-shadow:0 0 0 1px rgba(255,255,255,0.22),0 3px 10px rgba(0,0,0,0.9);"></div>
                <div style="display:flex;align-items:center;gap:6px;">
                  <svg width="17" height="11" viewBox="0 0 17 11" fill="white"><rect x="0" y="7" width="3" height="4" rx="0.8"/><rect x="4.5" y="4.5" width="3" height="6.5" rx="0.8"/><rect x="9" y="2" width="3" height="9" rx="0.8"/><rect x="13.5" y="0" width="3" height="11" rx="0.8"/></svg>
                  <svg width="15" height="11" viewBox="0 0 15 11" fill="white"><path d="M7.5 8.5a1.3 1.3 0 100 2.6 1.3 1.3 0 000-2.6z"/><path d="M3.2 5.8C4.6 4.4 6 3.8 7.5 3.8s2.9.6 4.3 2l1.2-1.2C11.3 3 9.5 2.2 7.5 2.2S3.7 3 2 4.6l1.2 1.2z" opacity=".5"/><path d="M0.5 3C2.6 1 4.9 0 7.5 0s4.9 1 7 3l-1.2 1.2C11.3 2.3 9.5 1.6 7.5 1.6S3.7 2.3 1.7 4.2L.5 3z" opacity=".3"/></svg>
                  <svg width="24" height="11" viewBox="0 0 24 11" fill="none"><rect x="0.5" y="0.5" width="19" height="10" rx="3" stroke="white" stroke-opacity=".35"/><rect x="2" y="2" width="14" height="7" rx="1.5" fill="white"/><path d="M21 3.5v4a1.8 1.8 0 000-4z" fill="white" fill-opacity=".45"/></svg>
                </div>
              </div>

              <!-- WA Header -->
              <div style="background:#128C7E;padding:11px 14px 11px 6px;display:flex;align-items:center;gap:2px;flex-shrink:0;">
                <div style="padding:4px 6px;color:rgba(255,255,255,0.85);flex-shrink:0;">
                  <svg width="10" height="17" viewBox="0 0 10 17" fill="none"><path d="M9 1.5L1.5 8.5L9 15.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div style="width:38px;height:38px;border-radius:50%;background:#0D1830;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;padding:3px;">
                  <svg viewBox="8 8 80 80" fill="none" style="width:100%;height:100%;">
                    <path d="M16 20 L48 76 L80 20 L62 20 L48 51 L34 20 Z" fill="#EFEAE0"/>
                  </svg>
                </div>
                <div style="flex:1;margin-left:8px;">
                  <p style="font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-weight:600;font-size:15px;color:#FFF;margin:0;line-height:1.2;">VantAr Asistente</p>
                  <p id="wa-status" style="font-family:-apple-system,sans-serif;font-size:11.5px;color:rgba(255,255,255,0.7);margin:0;line-height:1.3;transition:color 0.25s;">en línea</p>
                </div>
                <div style="display:flex;gap:18px;color:rgba(255,255,255,0.88);flex-shrink:0;">
                  <svg width="20" height="14" viewBox="0 0 22 15" fill="currentColor"><path d="M13 0H2C.9 0 0 .9 0 2v11c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V2c0-1.1-.9-2-2-2zM22 1.5l-5 3.5v5.5l5 3.5V1.5z"/></svg>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.58.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.26.2 2.47.57 3.6.11.34.03.74-.24 1.01L6.6 10.8z"/></svg>
                  <svg width="4" height="17" viewBox="0 0 4 18" fill="currentColor"><circle cx="2" cy="2" r="1.8"/><circle cx="2" cy="9" r="1.8"/><circle cx="2" cy="16" r="1.8"/></svg>
                </div>
              </div>

              <!-- Messages -->
              <div id="chat-messages" style="flex:1;min-height:0;overflow-y:auto;padding:10px 8px;display:flex;flex-direction:column;gap:4px;background:#ECE5DD;scrollbar-width:none;">

                <!-- Date chip — always visible, never hidden by reset -->
                <div style="align-self:center;background:#FFF;border-radius:8px;padding:4px 10px;font-size:11px;color:#54656F;box-shadow:0 1px 1px rgba(0,0,0,0.08);font-family:-apple-system,sans-serif;">Hoy</div>

                <!-- 0: client text -->
                <div data-msg="0" style="display:none;justify-content:flex-end;">
                  <div style="max-width:80%;padding:8px 10px 22px;border-radius:18px 18px 4px 18px;background:#D9FDD3;box-shadow:0 1px 2px rgba(0,0,0,0.13);position:relative;">
                    <p style="font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;font-weight:500;color:#111;margin:0;line-height:1.45;">Hola, sufrí un accidente laboral y necesito asesoramiento</p>
                    <div style="position:absolute;bottom:5px;right:8px;display:flex;align-items:center;gap:3px;">
                      <span style="font-family:-apple-system,sans-serif;font-size:10px;color:rgba(0,0,0,0.42);">10:41</span>
                      <span data-ticks data-state="none" style="display:inline-flex;align-items:center;">
                        <svg width="16" height="11" viewBox="0 0 16 11" fill="none">
                          <path class="tick-1" d="M1 6L4 9L10 1" stroke="#9AA5AC" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          <path class="tick-2" d="M6 6L9 9L15 1" stroke="#9AA5AC" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:0;"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>
                <!-- 1: agent -->
                <div data-msg="1" style="display:none;justify-content:flex-start;">
                  <div style="max-width:80%;padding:8px 10px 22px;border-radius:18px 18px 18px 4px;background:#FFFFFF;box-shadow:0 1px 2px rgba(0,0,0,0.13);position:relative;">
                    <p style="font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;font-weight:500;color:#111;margin:0;line-height:1.45;">¡Hola! Con gusto te ayudamos. ¿Cuándo ocurrió el accidente?</p>
                    <div style="position:absolute;bottom:5px;right:8px;"><span style="font-family:-apple-system,sans-serif;font-size:10px;color:rgba(0,0,0,0.42);">10:41</span></div>
                  </div>
                </div>
                <!-- 2: client -->
                <div data-msg="2" style="display:none;justify-content:flex-end;">
                  <div style="max-width:80%;padding:8px 10px 22px;border-radius:18px 18px 4px 18px;background:#D9FDD3;box-shadow:0 1px 2px rgba(0,0,0,0.13);position:relative;">
                    <p style="font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;font-weight:500;color:#111;margin:0;line-height:1.45;">Fue el lunes a la mañana</p>
                    <div style="position:absolute;bottom:5px;right:8px;display:flex;align-items:center;gap:3px;">
                      <span style="font-family:-apple-system,sans-serif;font-size:10px;color:rgba(0,0,0,0.42);">10:42</span>
                      <span data-ticks data-state="none" style="display:inline-flex;align-items:center;">
                        <svg width="16" height="11" viewBox="0 0 16 11" fill="none">
                          <path class="tick-1" d="M1 6L4 9L10 1" stroke="#9AA5AC" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          <path class="tick-2" d="M6 6L9 9L15 1" stroke="#9AA5AC" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:0;"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>
                <!-- 3: agent -->
                <div data-msg="3" style="display:none;justify-content:flex-start;">
                  <div style="max-width:80%;padding:8px 10px 22px;border-radius:18px 18px 18px 4px;background:#FFFFFF;box-shadow:0 1px 2px rgba(0,0,0,0.13);position:relative;">
                    <p style="font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;font-weight:500;color:#111;margin:0;line-height:1.45;">¿Podés contarnos brevemente cómo fue?</p>
                    <div style="position:absolute;bottom:5px;right:8px;"><span style="font-family:-apple-system,sans-serif;font-size:10px;color:rgba(0,0,0,0.42);">10:42</span></div>
                  </div>
                </div>
                <!-- 4: client audio -->
                <div data-msg="4" style="display:none;justify-content:flex-end;">
                  <div style="max-width:84%;background:#D9FDD3;border-radius:18px 18px 4px 18px;padding:10px 10px 22px;position:relative;box-shadow:0 1px 2px rgba(0,0,0,0.13);">
                    <div style="display:flex;align-items:center;gap:8px;">
                      <div style="width:34px;height:34px;border-radius:50%;background:#128C7E;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="11" height="13" viewBox="0 0 11 13" fill="white"><path d="M1 1l9 5.5L1 12V1z"/></svg>
                      </div>
                      <div style="display:flex;align-items:center;gap:2px;flex:1;">
                        {WAVEFORM.map((h) => (
                          <div data-wavebar style={`width:2px;height:${h}px;background:#A0A8A0;border-radius:2px;`}></div>
                        ))}
                      </div>
                      <span data-audio-time style="font-family:-apple-system,sans-serif;font-size:11px;color:rgba(0,0,0,0.5);flex-shrink:0;">0:14</span>
                      <div style="width:26px;height:26px;border-radius:50%;background:#B8C8B0;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:12px;">👤</div>
                    </div>
                    <div data-transcript style="display:none;">
                      <p style="font-family:-apple-system,sans-serif;font-size:12px;color:rgba(0,0,0,0.52);font-style:italic;margin:6px 0 0;line-height:1.45;">"Estaba en el depósito moviendo cajas y resbalé porque el piso estaba mojado sin señalización. Me lastimé la muñeca derecha y tuve que ir a la guardia."</p>
                    </div>
                    <div style="position:absolute;bottom:5px;right:8px;display:flex;align-items:center;gap:3px;">
                      <span style="font-family:-apple-system,sans-serif;font-size:10px;color:rgba(0,0,0,0.42);">10:43</span>
                      <span data-ticks data-state="none" style="display:inline-flex;align-items:center;">
                        <svg width="16" height="11" viewBox="0 0 16 11" fill="none">
                          <path class="tick-1" d="M1 6L4 9L10 1" stroke="#9AA5AC" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          <path class="tick-2" d="M6 6L9 9L15 1" stroke="#9AA5AC" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:0;"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>
                <!-- 5: agent -->
                <div data-msg="5" style="display:none;justify-content:flex-start;">
                  <div style="max-width:80%;padding:8px 10px 22px;border-radius:18px 18px 18px 4px;background:#FFFFFF;box-shadow:0 1px 2px rgba(0,0,0,0.13);position:relative;">
                    <p style="font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;font-weight:500;color:#111;margin:0;line-height:1.45;">Entendido. ¿Podés enviarnos el informe médico de la guardia?</p>
                    <div style="position:absolute;bottom:5px;right:8px;"><span style="font-family:-apple-system,sans-serif;font-size:10px;color:rgba(0,0,0,0.42);">10:43</span></div>
                  </div>
                </div>
                <!-- 6: client image -->
                <div data-msg="6" style="display:none;justify-content:flex-end;">
                  <div style="max-width:84%;background:#D9FDD3;border-radius:18px 18px 4px 18px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,0.13);position:relative;">
                    <!-- Medical report mini-doc -->
                    <div style="width:228px;height:178px;background:linear-gradient(170deg,#FEFDFB 0%,#F8F6EE 100%);position:relative;overflow:hidden;box-shadow:inset 0 0 28px rgba(0,0,0,0.07);">
                      <div style="border-bottom:1.5px solid #1A4A8F;padding:5px 10px 4px;display:flex;align-items:center;justify-content:space-between;background:rgba(26,74,143,0.03);">
                        <div>
                          <p style="font-family:sans-serif;font-weight:800;font-size:7.5px;color:#1A4A8F;margin:0;letter-spacing:0.04em;">HOSPITAL GENERAL DE AGUDOS</p>
                          <p style="font-family:sans-serif;font-size:6px;color:#5A6A8A;margin:0;">Guardia Médica · Urgencias y Emergencias</p>
                        </div>
                        <svg width="13" height="13" viewBox="0 0 12 12" fill="none"><rect x="4.5" y="0" width="3" height="12" rx="1" fill="#CC1111"/><rect x="0" y="4.5" width="12" height="3" rx="1" fill="#CC1111"/></svg>
                      </div>
                      <div style="background:rgba(26,74,143,0.06);padding:3px 10px;border-bottom:0.5px solid rgba(0,0,0,0.08);text-align:center;">
                        <span style="font-family:sans-serif;font-size:6.5px;font-weight:700;color:#222;letter-spacing:0.1em;text-transform:uppercase;">Certificado de Atención Médica</span>
                      </div>
                      <div style="padding:6px 10px;display:flex;flex-direction:column;gap:4px;">
                        <div style="display:flex;gap:10px;">
                          <div style="flex:1;"><span style="font-family:sans-serif;font-size:6px;color:#888;text-transform:uppercase;letter-spacing:0.04em;display:block;margin-bottom:1px;">Apellido y nombre</span><span style="font-family:sans-serif;font-size:7.5px;color:#1A1A1A;">García, Marcos A.</span></div>
                          <div style="flex:1;"><span style="font-family:sans-serif;font-size:6px;color:#888;text-transform:uppercase;letter-spacing:0.04em;display:block;margin-bottom:1px;">DNI</span><span style="font-family:sans-serif;font-size:7.5px;color:#1A1A1A;">32.744.901</span></div>
                        </div>
                        <div style="height:0.5px;background:rgba(0,0,0,0.08);"></div>
                        <div><span style="font-family:sans-serif;font-size:6px;color:#888;text-transform:uppercase;letter-spacing:0.04em;display:block;margin-bottom:1px;">Diagnóstico</span><span style="font-family:sans-serif;font-size:7.5px;color:#0D0D0D;font-weight:700;">Esguince grado II, muñeca derecha</span></div>
                        <div style="display:flex;gap:10px;">
                          <div style="flex:1;"><span style="font-family:sans-serif;font-size:6px;color:#888;text-transform:uppercase;letter-spacing:0.04em;display:block;margin-bottom:1px;">Ingreso</span><span style="font-family:sans-serif;font-size:7.5px;color:#1A1A1A;">Lun 10:23 hs</span></div>
                          <div style="flex:1;"><span style="font-family:sans-serif;font-size:6px;color:#888;text-transform:uppercase;letter-spacing:0.04em;display:block;margin-bottom:1px;">Alta</span><span style="font-family:sans-serif;font-size:7.5px;color:#1A1A1A;">13:05 hs</span></div>
                        </div>
                        <div><span style="font-family:sans-serif;font-size:6px;color:#888;text-transform:uppercase;letter-spacing:0.04em;display:block;margin-bottom:1px;">Tratamiento indicado</span><span style="font-family:sans-serif;font-size:7.5px;color:#1A1A1A;">Inmovilización + antiinfl. · Control 7 días</span></div>
                      </div>
                      <div style="position:absolute;bottom:6px;left:10px;right:10px;display:flex;align-items:flex-end;justify-content:space-between;">
                        <div>
                          <svg width="54" height="12" viewBox="0 0 54 12" fill="none" style="display:block;margin-bottom:1px;"><path d="M2 9 C6 3, 10 11, 14 7 C18 3, 20 10, 24 8 C28 6, 30 9, 34 7 C38 5, 40 8, 44 7 L50 6" stroke="#333" stroke-width="0.9" stroke-linecap="round" fill="none"/></svg>
                          <div style="width:54px;border-top:0.7px solid #555;margin-bottom:2px;"></div>
                          <p style="font-family:sans-serif;font-size:5.5px;color:#555;margin:0;">Dr. A. Ramírez · M.N. 44823</p>
                        </div>
                        <div style="width:44px;height:44px;border-radius:50%;border:2px solid rgba(20,50,160,0.35);display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(-10deg);gap:1px;">
                          <p style="font-family:sans-serif;font-size:5px;color:rgba(20,50,160,0.5);margin:0;letter-spacing:0.05em;font-weight:700;">H.G.A.</p>
                          <div style="width:24px;height:0.7px;background:rgba(20,50,160,0.35);"></div>
                          <p style="font-family:sans-serif;font-size:4.5px;color:rgba(20,50,160,0.45);margin:0;">ORIGINAL</p>
                        </div>
                      </div>
                      <div style="position:absolute;bottom:7px;left:76px;display:flex;gap:1.5px;align-items:flex-end;">
                        {[8,14,8,18,10,16,8,12,18,8,14,10,18,8,12].map((h: number) => (
                          <div style={`width:${h === 14 ? '3px' : '1.5px'};height:${h}px;background:#1A1A1A;border-radius:0.3px;`}></div>
                        ))}
                      </div>
                      <!-- Upload overlay -->
                      <div data-upload-overlay style="position:absolute;inset:0;z-index:2;background:rgba(240,238,232,0.55);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;opacity:1;">
                        <div style="width:34px;height:34px;border-radius:50%;border:3px solid rgba(0,0,0,0.15);border-top-color:#128C7E;animation:spin 0.8s linear infinite;"></div>
                        <span data-upload-pct style="font-family:-apple-system,sans-serif;font-size:11px;font-weight:600;color:#333;">0%</span>
